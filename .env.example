# Public production URL used for canonical links, sitemap, robots and social previews
# Example: https://www.nagmeena.com
NEXT_PUBLIC_SITE_URL=

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
ADMIN_EMAILS=
NEXT_PUBLIC_IMAGEKIT_URL_ENDPOINT=
IMAGEKIT_PUBLIC_KEY=
IMAGEKIT_PRIVATE_KEY=

# Optional automatic WhatsApp notification (leave disabled until Meta Cloud API is configured)
WHATSAPP_ENABLED=false
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_ADMIN_PHONE=

# Comma-separated Greater Noida free-delivery PIN codes.
NEXT_PUBLIC_FREE_DELIVERY_PINCODES=201304,201305,201306,201308,201309,201310,201311,201312,201314,201318

# Optional but required to actually send order-confirmation emails.
# Verify your sending domain in Resend first.
RESEND_API_KEY=
ORDER_EMAIL_FROM=NAGMEENA <orders@yourdomain.com>
